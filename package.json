{
  "name": "@jcioriente/baton",
  "version": "0.7.0",
  "type": "module",
  "description": "CLI behind the baton Claude Code plugin. No runtime dependencies.",
  "bin": {
    "baton": "cli/baton.mjs"
  },
  "files": [
    "cli",
    "!cli/test",
    "templates",
    "reviewers",
    "stacks",
    "hooks",
    "provenance.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'cli/test/*.test.mjs'"
  }
}
