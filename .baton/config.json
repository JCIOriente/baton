{
  "project": "baton",
  "stacks": ["javascript", "node"],
  "tasks": {
    "provider": "github",
    "repo": null
  },
  "git": {
    "baseBranch": "main",
    "branchPrefix": "task",
    "mergeStrategy": "squash"
  },
  "setup": [
    {
      "name": "install",
      "run": "npm ci"
    }
  ],
  "validate": [
    { "name": "secrets", "gates": ["secrets"], "run": "make secrets" },
    { "name": "install", "gates": ["install"], "run": "npm ci" },
    { "name": "lint", "gates": ["format", "lint"], "run": "make lint" },
    { "name": "structure", "gates": ["structure"], "run": "node cli/baton.mjs structure" },
    { "name": "audit", "gates": ["audit"], "run": "npm audit --audit-level=high" },
    { "name": "tests", "gates": ["unit-tests", "integration-tests"], "run": "make test" },
    { "name": "plugin", "gates": ["build"], "run": "make plugin-validate" },
    { "name": "pack", "gates": ["publish"], "run": "npm pack --dry-run" }
  ],
  "gates": {
    "skip": {
      "unused-deps": "one devDependency (Biome), used by the lint step"
    }
  },
  "structure": {
    "allowlist": {
      "cli/baton.mjs": 1111,
      "cli/test/features.test.mjs": 913,
      "cli/test/git-guard.test.mjs": 742,
      "cli/test/release-templates.test.mjs": 718,
      "cli/test/worktree-cli.test.mjs": 1088
    }
  },
  "workflow": {
    "phases": ["spec", "plan", "backlog", "implement", "verify", "review", "integrate"],
    "custom": {},
    "requireSpec": true,
    "requireTdd": true,
    "requireReview": true,
    "baselineOnStart": true
  },
  "hooks": {
    "factGate": false
  },
  "docs": {
    "specs": "docs/specs",
    "plans": "docs/plans",
    "commonIssues": "docs/common-issues.md"
  },
  "conventions": [],
  "release": {
    "enabled": true,
    "publish": ["npm"]
  }
}
