    { "id": "deps.pnpm-add-lockfile-only", "file": "skills/deps/SKILL.md", "anchor": "`pnpm add <pkg>@<v> --lockfile-only --ignore-scripts`", "pkg": "npm:pnpm", "requires": ">=11.5 <13", "verified": "2026-11-06", "note": "accepted by 11.5.1 (not in `pnpm add --help`) and 12.18.0 (listed); writes pnpm-lock.yaml, no node_modules" },
    { "id": "deps.pnpm-audit-ignore-list", "file": "skills/deps/SKILL.md", "anchor": "pnpm `auditConfig.ignoreGhsas` in `pnpm-workspace.yaml`", "pkg": "npm:pnpm", "requires": ">=11.5 <13", "verified": "2026-11-06", "note": "11.5.1 and 12.18.0 read it there, not from the package.json pnpm field; `pnpm audit --ignore <id>` appends the id to that file" },
    { "id": "deps.yarn-classic-audit-bitmask", "file": "skills/deps/SKILL.md", "anchor": "`exit & 24`", "pkg": "npm:yarn", "requires": ">=1.22 <2", "verified": "2026-11-06", "note": "yarn 1.22.22: `yarn audit --level critical` exits 12 (lodash@4.17.15) and 10 (node-fetch@2.6.0) with no critical advisory" },
    { "id": "deps.yarn-berry-audit-all", "file": "skills/deps/SKILL.md", "anchor": "`yarn npm audit --all --recursive --severity high`", "pkg": "npm:@yarnpkg/cli-dist", "requires": ">=4.9 <5", "verified": "2026-11-06", "note": "4.9.2 and 4.18.1: without --all, an audit at the root exits 0 when only a workspace member is affected" },
    { "id": "deps.yarn-berry-ignore-id", "file": "skills/deps/SKILL.md", "anchor": "numeric `ID` from `--json`, not the GHSA", "pkg": "npm:@yarnpkg/cli-dist", "requires": ">=4.9 <5", "verified": "2026-11-06", "note": "4.9.2 and 4.18.1: npmAuditIgnoreAdvisories matches the numeric advisory ID; GHSA ids are not matched" },
    { "id": "deps.yarn-berry-info-per-version", "file": "skills/deps/SKILL.md", "anchor": "`yarn npm info <pkg>@<v> --fields version,deprecated,peerDependencies --json`", "pkg": "npm:@yarnpkg/cli-dist", "requires": ">=4.9 <5", "verified": "2026-11-06", "note": "4.9.2 and 4.18.1: without a version, deprecated and peerDependencies describe latest (react-dom: react ^19.3.1; react-dom@18.3.1: ^18.3.1); a version that is not deprecated has no deprecated key (zod@4.1.12 prints only name); uuid@3.4.0 prints its deprecation. A version that does not exist exits 0 with latest's manifest: with version in --fields, uuid@99.0.0 prints version 14.0.3 and react-dom@99.0.0 latest's peers (react ^19.3.1); without it, uuid@99.0.0 prints only name" }
